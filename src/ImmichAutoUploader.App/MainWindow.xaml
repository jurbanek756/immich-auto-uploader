<Window x:Class="ImmichAutoUploader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Immich Auto Uploader — Settings" Height="780" Width="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." />
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <GroupBox Header="Immich Server" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <Label Content="Server URL" Padding="0,0,0,2"/>
                        <TextBox x:Name="TxtUrl" Margin="0,0,0,8"/>

                        <Label Content="API Key" Padding="0,0,0,2"/>
                        <PasswordBox x:Name="TxtApiKey" Margin="0,0,0,8"/>

                        <Label Content="Admin API Key (optional)" Padding="0,0,0,2"/>
                        <PasswordBox x:Name="TxtAdminApiKey" Margin="0,0,0,4"/>
                        <TextBlock Text="Passed to immich-go as --admin-api-key so it can pause/resume server jobs during upload."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Folders" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <Label Content="Watch folder (new photos/videos here get uploaded)" Padding="0,0,0,2"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="Browse…" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0"
                                    Click="BrowseWatch_Click"/>
                            <TextBox x:Name="TxtWatchFolder" IsReadOnly="True"/>
                        </DockPanel>

                        <Label Content="Done folder (files are MOVED here after successful upload)" Padding="0,0,0,2"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="Browse…" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0"
                                    Click="BrowseDone_Click"/>
                            <TextBox x:Name="TxtDoneFolder" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Text="Files are moved, never deleted. If an upload fails, the file stays in the watch folder for retry."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Jellyfin (optional)" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <Label Content="Server URL" Padding="0,0,0,2"/>
                        <TextBox x:Name="TxtJellyfinUrl" Margin="0,0,0,8"/>

                        <Label Content="API Key" Padding="0,0,0,2"/>
                        <PasswordBox x:Name="TxtJellyfinApiKey" Margin="0,0,0,8"/>

                        <Label Content="Library name to refresh (blank = all libraries)" Padding="0,0,0,2"/>
                        <TextBox x:Name="TxtJellyfinLibrary" Margin="0,0,0,4"/>
                        <TextBlock Text="After a successful upload batch, the app triggers a Jellyfin refresh so new photos appear without a manual scan."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Tailscale (optional)" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="ChkUseTailscale" Content="Connect Tailscale before uploads"
                                  Margin="0,0,0,8"/>
                        <Label Content="Immich URL via Tailscale (optional)" Padding="0,0,0,2"/>
                        <TextBox x:Name="TxtTailscaleUrl" Margin="0,0,0,4"/>
                        <TextBlock Text="Runs 'tailscale up' if needed before each batch (e.g. http://100.x.y.z:2283), then 'tailscale down' afterwards — but only when the app itself connected it. A connection you made yourself is left alone."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Upload Engine (immich-go)" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Label Content="Bundled immich-go:" Padding="0,0,0,2" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblGoVersion" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Text="(not found)"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="Browse…" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0"
                                    Click="BrowseGo_Click"/>
                            <TextBox x:Name="TxtGoPath"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Concurrent tasks" Padding="0,0,0,2"/>
                                <TextBox x:Name="TxtConcurrentTasks"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="On errors" Padding="0,0,0,2"/>
                                <ComboBox x:Name="CmbOnErrors">
                                    <ComboBoxItem Content="continue"/>
                                    <ComboBoxItem Content="stop"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkPauseJobs" Content="Pause Immich server jobs during upload (needs admin key)"
                                  Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Upload batch every (minutes):" Padding="0,0,0,2" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtBatchMinutes" Width="50" Margin="8,0,0,0"/>
                            <Label Content="Max files per batch:" Padding="16,0,0,2" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtBatchSize" Width="50" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="General" Margin="0,0,0,12" Padding="10">
                    <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows"/>
                </GroupBox>

                <GroupBox Header="Upload Queue" Margin="0,0,0,12" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Upload now" Width="90" Click="UploadNow_Click"/>
                            <Button Content="Retry failed" Width="90" Margin="8,0,0,0" Click="RetryFailed_Click"/>
                            <Button Content="Refresh" Width="80" Margin="8,0,0,0"
                                    Click="RefreshQueue_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtQueueStatus" VerticalAlignment="Center" Text="…"/>
                    </DockPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Test Connection" Width="120" Margin="0,0,8,0" Click="TestConnection_Click"/>
                    <Button Content="Save" Width="100" IsDefault="True" Click="Save_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
