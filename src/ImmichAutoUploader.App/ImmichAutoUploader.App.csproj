<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms interop for NotifyIcon (system tray) + FolderBrowserDialog -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ImmichAutoUploader.App</RootNamespace>
    <AssemblyName>ImmichAutoUploader</AssemblyName>
    <!-- Single-file publish: dotnet publish -c Release -r win-x64, self-contained -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImmichAutoUploader.Core\ImmichAutoUploader.Core.csproj" />
  </ItemGroup>

  <!-- Bundle the pinned immich-go (fetched by build.ps1) alongside the app -->
  <ItemGroup>
    <Content Include="..\..\tools\immich-go\**" CopyToOutputDirectory="PreserveNewest"
             Link="tools\immich-go\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
